# LANTERN: relit from sketch/lantern.png, silhouette unchanged.
# light: top-left, shaded per plate. K on the outer contour only; inner seams use the dark step.
palette
. transparent
K #0b0d1a outline
d #261a2e shared-dark
X #45444e steel-mid
n #7c7a88 steel-light
N #bfbdc8 steel-pale
b #804676 armour-mid
m #bd7da5 armour-light
o #ecdcc4 bone
a #766458 accent-dark
A #c2b29c accent-mid
g #4e9a1e core-dark
G #a8f030 core
w #f0ffb0 core-glint
frame f1 100
