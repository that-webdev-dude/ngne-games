# LANCER: relit from sketch/lancer.png, silhouette unchanged.
# light: top-left, shaded per plate. K on the outer contour only; inner seams use the dark step.
palette
. transparent
K #0b0d1a outline
d #261a2e shared-dark
X #45444e steel-mid
n #7c7a88 steel-light
N #bfbdc8 steel-pale
b #4e4475 armour-mid
m #867db2 armour-light
o #ecdcc4 bone
a #4c3a30 accent-dark
A #886c4e accent-mid
h #b8a680 accent-light
g #4e9a1e core-dark
G #a8f030 core
w #f0ffb0 core-glint
frame f1 100
